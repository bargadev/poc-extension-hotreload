{
  "manifest_version": 3,
  "name": "Meet Sidebar",
  "version": "1.0.0",
  "description": "Google Meet sidebar with editable notes",
  "permissions": ["alarms", "storage", "scripting", "tabs"],
  "host_permissions": ["http://localhost/*", "https://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meet Sidebar"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["rtc-sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
